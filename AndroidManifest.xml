<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Draw over other apps (the whole point of the debugger). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- For showing the foreground service notification on Android 8+. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- OpenGL ES 3.0 is required for the ImGui renderer. -->
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />

  <application
      android:label="Joint Position Debugger"
      android:icon="@android:drawable/sym_def_app_icon"
      android:hardwareAccelerated="true"
      android:allowBackup="false"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <service
        android:name=".Services.OverlayService"
        android:exported="false" />
  </application>
</manifest>
